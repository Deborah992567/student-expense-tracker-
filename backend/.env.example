DATABASE_URL=sqlite:///./student_expense.db
API_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8003,http://127.0.0.1:8003,http://localhost:5501,http://127.0.0.1:5501,null
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=10
EMAIL_VERIFICATION_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=no-reply@student-spend.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
FRONTEND_URL=http://127.0.0.1:8003
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_DIR=backend/backups
MAINTENANCE_INTERVAL_SECONDS=300
ARCHIVE_AFTER_DAYS=365
